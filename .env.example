# Environment variables for QUANTA monorepo
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Engine (Python)
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8000
AI_ENGINE_WORKERS=1

# Optimization Engine (Python - Parv)
OPTIMIZATION_ENGINE_HOST=0.0.0.0
OPTIMIZATION_ENGINE_PORT=8001

# Backend (Go - Aryan)
BACKEND_PORT=8080
POSTGRES_USER=quanta_admin
POSTGRES_PASSWORD=quanta_secure_dev_password
POSTGRES_DB=quanta_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://quanta_admin:quanta_secure_dev_password@localhost:5432/quanta_db?sslmode=disable

# Frontend (SvelteKit - Aryan)
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080
