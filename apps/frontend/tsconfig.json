{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"]
}
